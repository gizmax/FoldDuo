<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Built-in widgets (AppleWidgets.kt); each is requested on tap from its card, never at launch. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- StandBy (standby/): the pose service is a special-use foreground service; its notification
         needs POST_NOTIFICATIONS; SYSTEM_ALERT_WINDOW is the Android 10+ exemption for starting
         StandByActivity from the service while Home is not in front (requested from settings);
         BOOT_COMPLETED restarts the service after a reboot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- B16, "Haptic at flat" (UnfoldMorph.kt performFlatTick): one EFFECT_TICK when the unfold morph reaches Flat. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Spotlight (B28, Spotlight.kt): contacts row, requested on first use; UsageStats app-op
         recency needs the permission declared even though it is granted from a special Settings
         screen, not the runtime dialog (SpotlightModel.kt falls back to launch history/alphabetical
         without it). Neither reaches the network — this app still has no INTERNET permission. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- B42, seam palette (SeamPalette.kt): the DND tile calls NotificationManager.setInterruptionFilter,
         which needs this declared even though the actual "policy access" grant is a special
         Settings screen (ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS), not a runtime dialog —
         without the grant the tile just opens that screen instead of toggling. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Icon packs (IconPacks.kt): Nova / ADW / Apex / Lawnchair conventions. -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
    </queries>
    <application android:label="Fold Duo" android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.Duo" android:allowBackup="false" android:supportsRtl="true">
        <!-- Live wallpaper (DuneWallpaper.kt, IDEAS B2): one picture framed for both panels, the
             unfold frost played on the panel swap; under the lock screen and any launcher. -->
        <service android:name=".DuneWallpaperService" android:label="Fold Duo"
            android:description="@string/dune_wallpaper_description"
            android:permission="android.permission.BIND_WALLPAPER" android:exported="true">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/dune_wallpaper" />
        </service>
        <!-- Shizuku research spike (docs/research/shizuku.md, shizuku/ShizukuBridge.kt): lets the
             Shizuku app discover this package and hand it the privileged shell/root binder.
             Compile-only — no setting reads or wires this, ShizukuBridge.isEnabled() is unused. -->
        <provider android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false" android:enabled="true" android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <service android:name=".SystemShadeAccessibilityService"
            android:label="@string/shade_service_label"
            android:description="@string/shade_service_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/system_shade_accessibility_service" />
        </service>
        <!-- Rail island (island/IslandNotificationListener.kt): promoted / ongoing notifications
             and media sessions only; nothing is stored or forwarded. -->
        <service android:name=".island.IslandNotificationListener"
            android:label="@string/island_listener_label"
            android:description="@string/island_listener_description"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTask" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- StandBy without a charger (PLAN.md Fáze 4): own task, over the keyguard, wakes the cover;
             fullSensor so a tented cover is landscape whatever the rotation lock says. -->
        <activity android:name=".standby.StandByActivity" android:exported="false"
            android:theme="@style/Theme.Duo.StandBy"
            android:showWhenLocked="true" android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" android:taskAffinity="cz.pflanzer.foldduo.standby"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode" />
        <service android:name=".standby.StandByService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pose-driven ambient display: watches how the foldable is placed (tent or closed on a table) and shows the StandBy clock on the cover screen." />
        </service>
        <receiver android:name=".standby.StandByBootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
        <!-- The same faces as a system screen saver, for a charger or dock. -->
        <service android:name=".standby.StandByDreamService" android:exported="true"
            android:label="Fold Duo StandBy"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/standby_dream" />
        </service>
    </application>
</manifest>
